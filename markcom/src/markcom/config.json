{
  "log_format": "%(asctime)s %(levelname)s %(name)s: %(message)s",
  "desktop_entry_owner_key": "X-Markcom-App",
  "tray": {
    "icon_size": 64,
    "badge_size": 28,
    "badge_text_size": 20,
    "badge_margin": 3,
    "badge_colour": "#d32f2f",
    "badge_text_colour": "#ffffff"
  },
  "window": {
    "width": 1280,
    "height": 800
  },
  "ui_server": {
    "shutdown_grace_sec": 1,
    "binding_refresh_sec": 0.5,
    "reconnect_timeout_sec": 3.0,
    "message_history": 1000
  }
}
