{
  "name": "@markcom/web-config",
  "version": "0.1.0",
  "description": "Shared ESLint, Prettier, TypeScript and Vitest coverage settings for the react-ui websites.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkIsMyNames/ClaudeSkills.git",
    "directory": "libraries/markcom-web-config"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "prettier.json",
    "tsconfig.json"
  ],
  "exports": {
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "default": "./dist/eslint.mjs"
    },
    "./prettier": "./prettier.json",
    "./vitest": {
      "types": "./dist/vitest.d.mts",
      "default": "./dist/vitest.mjs"
    },
    "./tsconfig.json": "./tsconfig.json"
  },
  "prettier": "./prettier.json",
  "scripts": {
    "build": "tsdown src/eslint.ts src/vitest.ts --dts --format esm --clean",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --ignore-path ../../.gitignore --write .",
    "format:check": "prettier --ignore-path ../../.gitignore --check .",
    "typecheck": "tsc",
    "audit": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2",
    "@tsconfig/strictest": "^2.0.8"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5",
    "glob": "^14.0.4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
